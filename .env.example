# Veritabanı
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/sms_panel?schema=public&connection_limit=20&pool_timeout=20"

# JWT Gizli Anahtarı - En az 32 karakter, güçlü ve benzersiz bir değer kullanın
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# SMS API Ayarları
# Sağlayıcınızın base URL veya tam send endpoint değerini girin.
# Uygulama gerektiğinde /sms-api/send yolunu otomatik ekler.
SMS_API_URL="https://your-sms-provider.example/api"
SMS_API_KEY="your-sms-api-key"

# Sadece development için. Production ortamında false olmalı.
SMS_DEV_MODE="true"
SMS_REQUEST_TIMEOUT_MS="10000"

# SMS logları bu süreden eskiyse otomatik temizlenir.
SMS_LOG_RETENTION_DAYS="30"
SMS_QUEUE_BATCH_SIZE="50"
SMS_QUEUE_CONCURRENCY="12"
SMS_QUEUE_STALE_MINUTES="2"
ALLOW_PRODUCTION_SMS_DEV_MODE="false"

# Yalnızca güvenilir bir reverse proxy arkasındaysanız true yapın.
TRUST_PROXY_HEADERS="false"

# Uygulama URL'si
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Decodo gateway proxy ayarları
PROXY_ENABLED="false"
DECODO_PROXY_HOST="gate.decodo.com"
DECODO_PROXY_PORT_START="10001"
DECODO_PROXY_ENDPOINT_COUNT="100"
DECODO_PROXY_USERNAME="your-decodo-username"
DECODO_PROXY_PASSWORD="your-decodo-password"
DECODO_PROXY_PROTOCOL="http"

# Seed ile oluşturulacak veya güncellenecek admin hesabı
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_NAME="Admin"
ADMIN_SEED_PASSWORD="REPLACE_WITH_A_STRONG_ADMIN_PASSWORD"
